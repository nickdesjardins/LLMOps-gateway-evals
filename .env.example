# Copy to .env (or .env.local, which overrides .env) and fill in what you have. Every value has a
# default in app/config.py; blank means "unset". Never commit either file.

# ---------------------------------------------------------------- application
SERVICE_NAME=llmops-gateway
# development | test | production (production hides /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Keys accepted as "Authorization: Bearer <key>" on /v1/chat/completions, comma-separated.
# Outside demo mode that route is closed without one. These are YOUR gateway's keys, not a
# provider's.
GATEWAY_API_KEYS=
# Browser origins allowed to call the API (the GitHub Pages site), comma-separated.
CORS_ALLOW_ORIGINS=
PLAYGROUND_ENABLED=true
MAX_BODY_BYTES=32768

# ----------------------------------------------------------------- providers
# openrouter (default, free models) | anthropic | openai | gemini | offline (no model at all)
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys. Free endpoints may keep and train on what they are
# sent: the corpus here is fictional, keep it that way while the service runs on free models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Refuse any OpenRouter model id that does not end in :free.
OPENROUTER_FREE_ONLY=true
# default | off | low | medium | high. Thinking tokens count against the output ceiling.
OPENROUTER_REASONING=off

# Anthropic (Claude): https://console.anthropic.com. Light: claude-haiku-5-5, heavy:
# claude-opus-5-5 unless LIGHT_MODELS / HEAVY_MODELS say otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT_LIGHT=low
ANTHROPIC_EFFORT_HEAVY=medium

# OpenAI: name the models in LIGHT_MODELS and HEAVY_MODELS (ids from your account's model list).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini, through its OpenAI-compatible endpoint: name the models in LIGHT_MODELS / HEAVY_MODELS.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ordered, comma-separated chains. Blank: the provider's default (app/config.py).
LIGHT_MODELS=
HEAVY_MODELS=
# When every model of a tier fails, try the other tier before giving up.
CROSS_TIER_FALLBACK=true
MODEL_TIMEOUT_S=45
REQUEST_DEADLINE_S=90

# ------------------------------------------------------------ token ceilings
MAX_OUTPUT_TOKENS_LIGHT=350
MAX_OUTPUT_TOKENS_HEAVY=900
MAX_INPUT_TOKENS=6000

# ---------------------------------------------------------------- embeddings
# fastembed: BAAI/bge-small-en-v1.5 on the CPU (downloaded once, about 67 MB).
# hash: no model at all; only exact repeats and near-identical wording will hit the cache.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=
FASTEMBED_THREADS=

# ------------------------------------------------------------ semantic cache
# auto: Redis when REDIS_URL is set, memory otherwise. redis | memory | off.
CACHE_BACKEND=auto
# Local: docker compose up -d redis, then redis://localhost:6379/0
# Redis Cloud: the rediss:// URL from the database's Connect page (it holds the password).
REDIS_URL=
REDIS_INDEX_NAME=llmops-cache-idx
REDIS_KEY_PREFIX=llmops:cache:
CACHE_SIMILARITY_THRESHOLD=0.96
CACHE_CONTRAST_GUARD=true
CACHE_TTL_S=86400
CACHE_MAX_ENTRIES=5000

# ------------------------------------------------------------ routing and RAG
ROUTER_HEAVY_THRESHOLD=0.5
RETRIEVAL_TOP_K=4
# defang (answer, flagged) | block (refuse a request that looks like an injection)
INJECTION_POLICY=defang

# ----------------------------------------------------------------- telemetry
# Langfuse Cloud (free Hobby plan): Settings > API keys of a project. Both or neither.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US), or your own host.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false: only numbers and ids go to Langfuse, never the text of a question or an answer.
LANGFUSE_CAPTURE_CONTENT=true
TRACES_KEPT=200
# The paid models every call is priced against when it is itself free.
REFERENCE_MODEL_LIGHT=claude-haiku-5-5
REFERENCE_MODEL_HEAVY=claude-opus-5-5
# Extra prices, USD per million tokens: {"model-id": [input, output, cache_read]}
MODEL_PRICES=

# ------------------------------------------------------------- public demo
DEMO_MODE=false
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=CF-Connecting-IP
REQUESTS_PER_MINUTE_PER_CLIENT=20
MODEL_CALLS_PER_DAY_PER_CLIENT=40
MODEL_CALLS_PER_MINUTE=15
MODEL_CALLS_PER_DAY=600
MAX_INFLIGHT=3
QUESTION_MAX_CHARS=500

# ------------------------------------------------- evaluation (CI and local)
# The judge behind DeepEval: openrouter (default) | anthropic | openai | gemini
EVAL_JUDGE_PROVIDER=openrouter
EVAL_JUDGE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
EVAL_JUDGE_MIN_INTERVAL_S=3.2
# The judge behind Ragas (any OpenAI-compatible endpoint; reads OPENROUTER_API_KEY)
RAGAS_JUDGE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
RAGAS_MIN_INTERVAL_S=3.2
